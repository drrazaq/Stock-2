+
+test('conflicting exits: last night\'s trend exit is SELL in the first check, never HOLD, and agrees with ACTIONS', async t => {
+  const pos = { ZZG: { entry: 6, stop: 1.98, kind: 'leader', since: '2026-10-20' } };
