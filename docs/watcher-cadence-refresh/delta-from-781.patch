@@ -0,0 +1,2 @@
+import test from 'node:test';import assert from 'node:assert/strict';import {nov2Fixture} from './watcher-nov2-fixture.mjs';
+for(const [date,start] of [['2026-10-30','2026-10-30T13:10:00Z'],['2026-11-02','2026-11-02T14:10:00Z']])test('actual watcher covers each configured minute with 2.5second snapshot work '+date,async()=>{const f=await nov2Fixture();try{f.state.slowMs=2500;const r=await f.workflow({start,event:'schedule',schedule:'CURRENT_CRON'});assert.equal(r.code,0,r.output);const j=f.read('data/ignition-runs/'+date+'/101-1.json'),observed=new Set(j.heartbeat.map(x=>x.m)),missing=Array.from({length:331},(_,i)=>570+i).filter(m=>!observed.has(m));assert.deepEqual(missing,[],'work shorter than a minute must not accumulate drift');assert.equal(observed.has(900),true);assert.ok(r.trace.ended-Date.parse(start)<=360*60000);assert.equal(f.state.dispatches,0);console.log(JSON.stringify({date,retained:j.heartbeat.length,configuredObserved:331-missing.length,missing}));}finally{f.close();}});
