+#!/usr/bin/env bash
+# The privacy cutover and its rollback, as LOCAL git changes in this checkout (private data migration, 28 Oct 2026). Run only by
+# private-data-check.yml (action cutover / rollback, typed confirmation), which first stops the bot, the scan and the watcher, then commits
+# and pushes what this script staged, then restarts the bot. Tests: test/private-data.test.mjs.
+#   cutover   (the caller first runs .github/scrub-public.mjs and then 'private-data.sh check', so the private repository holds every
+#             file, including the parts moved out of public files) write .github/private-data-mode = private, add every private file to
+#             .gitignore, stop tracking them (git rm --cached: the files stay on disk; history is unchanged).
+#   rollback  'private-data.sh restore' (private copies -> data/), remove the mode file and the .gitignore block, track the files again.
+#             WARNING: this publishes the owner's files in the public repository again.
+set -eu
+ROOT=${PRIVATE_DATA_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}
+cd "$ROOT"
+FILES=$(grep -vE '^\s*(#|$)' .github/private-files.txt)
+BEGIN='# >>> owner private files (privacy cutover; see docs/private-data-migration-2026-10-28.md)'
+END='# <<< owner private files'
+drop_block() { [ -f .gitignore ] || return 0; awk -v b="$BEGIN" -v e="$END" '$0==b{s=1;next} $0==e{s=0;next} !s' .gitignore > .gitignore.tmp && mv .gitignore.tmp .gitignore; [ -s .gitignore ] || { git rm -q --cached .gitignore 2>/dev/null || true; rm -f .gitignore; }; }
+case "${1:-}" in
+  cutover)
+    [ -f .github/private-data-mode ] && { echo "cutover: already done"; exit 0; }
+    echo private > .github/private-data-mode
+    drop_block; { echo "$BEGIN"; for f in $FILES; do echo "data/$f"; done; echo "$END"; } >> .gitignore
+    n=0; for f in $FILES; do git ls-files --error-unmatch "data/$f" >/dev/null 2>&1 && { git rm -q --cached "data/$f"; n=$((n+1)); }; done
+    git add .gitignore .github/private-data-mode data/signals.json data/squad29-lab.json data/squad29-flags-today.json data/hold-lab.json 2>/dev/null || true
+    echo "cutover staged: $n private files no longer tracked (still on disk), mode file and .gitignore added" ;;
+  rollback)
+    bash .github/private-data.sh restore
+    rm -f .github/private-data-mode; git rm -q --cached .github/private-data-mode 2>/dev/null || true; drop_block
+    n=0; for f in $FILES; do [ -f "data/$f" ] && { git add -f "data/$f"; n=$((n+1)); }; done
+    [ -f .gitignore ] && git add .gitignore; true
+    echo "rollback staged: $n private files tracked again, mode file removed" ;;
+  *) echo "usage: private-cutover.sh cutover|rollback"; exit 2 ;;
+esac
