+// ---- workflow wiring ----
+const WF = path.join(REPO, '.github/workflows'), wfText = (f) => R(WF, f);
+const depsOf = (f, seen = new Set()) => { const p = path.join(REPO, f); if (seen.has(f) || !fs.existsSync(p)) return seen; seen.add(f); for (const m of R(REPO, f).matchAll(/from '\.\/([\w.-]+\.mjs)'|import\('\.\/([\w.-]+\.mjs)'\)/g)) depsOf(m[1] || m[2], seen); return seen; };
+const readsPrivate = (y) => { const files = new Set(); for (const m of y.matchAll(/node\s+(?:--[\w=-]+\s+)*([\w.-]+\.mjs)/g)) for (const d of depsOf(m[1])) { const s = R(REPO, d); for (const p of FILES) if (s.includes(p)) files.add(p); } return files; };
+test('every workflow that runs a script reading a private file pulls the private copies right after each checkout', () => {
+  let n = 0;
+  for (const f of fs.readdirSync(WF)) { const y = wfText(f); if (!readsPrivate(y).size) continue; n++;
+    const lines = y.split('\n'), checkouts = lines.filter(l => /^\s*- uses: actions\/checkout@/.test(l)).length, pulls = (y.match(/run: bash \.github\/private-data\.sh pull/g) || []).length;
+    assert.ok(pulls >= Math.min(1, checkouts) && pulls <= checkouts && pulls > 0, f + ': ' + pulls + ' pulls for ' + checkouts + ' checkouts'); }
+  assert.ok(n >= 60, n + ' workflows');
+});
+test('every workflow whose scripts WRITE a private file saves it back (push); the others get the read-only token first', () => {
+  const writes = (y) => { for (const m of y.matchAll(/node\s+(?:--[\w=-]+\s+)*([\w.-]+\.mjs)/g)) for (const d of depsOf(m[1])) { const s = R(REPO, d);
+    for (const p of FILES) if (new RegExp('(writeFileSync|appendFileSync|\\bW)\\([^)]*(' + p.replace('.', '\\.') + '|POS_FILE|PRIV_FILE|EXTRA_FILE|BASKET_STATE|PV_FILE|PRIV_HOLD|OWNER_OUT)').test(s) && !/agent-a-lab/.test(d)) return true; } return false; };
+  for (const f of fs.readdirSync(WF)) { const y = wfText(f); if (!readsPrivate(y).size) continue;
+    if (writes(y)) assert.match(y, /private-data\.sh push/, f + ' writes a private file but never saves it to the private repository');
+    else assert.match(y, /PRIVATE_DATA_TOKEN: \$\{\{ secrets\.PRIVATE_DATA_READ \|\| secrets\.PRIVATE_DATA_TOKEN \}\}/, f + ': readers use the read-only token when it exists'); }
