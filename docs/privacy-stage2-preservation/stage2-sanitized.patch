 name: Private data connection check
-# Privacy migration, owner approved 28 Oct 2026. Run this ONCE after adding the secret PRIVATE_DATA_TOKEN (Actions tab -> this workflow ->
-# Run workflow). It reads and writes the private repository drrazaq/stock-2-private-data, copies the owner's private files there, reads
-# them back and compares checksums, and reports the token's expiry date. It prints file NAMES and counts only, never contents or the
-# token. Production keeps reading THIS repository; after a pass the bot and the nightly scan also keep a copy there (mirror).
-# Nothing is deleted here. Script and tests: .github/private-data.sh, test/private-data.test.mjs.
+# Privacy migration (owner request 28 Oct 2026). Script: .github/private-data.sh; plan, checklist and rollback:
+# docs/private-data-migration-2026-10-28.md. Prints file NAMES and counts only, never contents or the token.
+#   check     (default when run by hand) read, write, copy, read back identical, token expiry. Nothing in production changes.
+#   verify    READ ONLY (also every day on the schedule): both copies identical before the cutover; after it, holdings present and no
+#             private file tracked here. Telegram only on a problem or when the token expires within 14 days.
+#   cutover   ONLY WITH THE OWNER'S APPROVAL and confirm = CUTOVER: stops the bot, scan and watcher runs, moves the owner marks out of
+#             public files, copies everything to the private repository and checks it, then stops tracking the private files here
+#             (they stay in git history), commits, verifies and restarts the bot. Any failure before the commit changes nothing.
+#   rollback  confirm = ROLLBACK: the reverse (private copies back into this PUBLIC repository; publishes them again).
 on:
   workflow_dispatch:
+    inputs:
+      action:
+        description: 'check, verify, cutover or rollback'
+        required: false
+        default: 'check'
+      confirm:
+        description: 'cutover needs CUTOVER, rollback needs ROLLBACK'
+        required: false
+        default: ''
+  schedule:
+    - cron: '17 4 * * *'   # daily read-only verify (7:17 Kuwait)
   push:
     branches: [main]
     paths: [run-private-data-check-now.txt]
 permissions:
-  contents: read
+  contents: write
+  actions: write   # cutover / rollback stop and restart the bot, scan and watcher runs
 concurrency: private-data-check
 jobs:
-  check:
+  run:
     runs-on: ubuntu-latest
-    timeout-minutes: 10
+    timeout-minutes: 20
+    env:
+      ACTION: ${{ github.event_name == 'schedule' && 'verify' || github.event.inputs.action || 'check' }}
+      CONFIRM: ${{ github.event.inputs.confirm }}
+      PRIVATE_DATA_TOKEN: ${{ secrets.PRIVATE_DATA_TOKEN }}
+      GH_TOKEN: ${{ github.token }}
     steps:
       - uses: actions/checkout@v4
         with:
           ref: main
       - id: c
-        env:
-          PRIVATE_DATA_TOKEN: ${{ secrets.PRIVATE_DATA_TOKEN }}
+        shell: bash
         run: |
           set -o pipefail
-          bash .github/private-data.sh check 2>&1 | tee check.log
+          git config user.name "scanner"; git config user.email "scanner@users.noreply.github.com"
+          case "$ACTION" in
+            check|verify) bash .github/private-data.sh "$ACTION" 2>&1 | tee check.log ;;
+            cutover|rollback)
+              want=$(echo "$ACTION" | tr a-z A-Z); [ "$CONFIRM" = "$want" ] || { echo "private data: Error: $ACTION needs confirm = $want; nothing done" | tee check.log; exit 1; }
+              # 1. stop every run that writes or reads the owner's files live, so nothing saves during the switch
+              for w in bot.yml main.yml ignition.yml news.yml; do for id in $(gh run list -R "$GITHUB_REPOSITORY" -w "$w" --json databaseId,status -q '.[] | select(.status != "completed") | .databaseId'); do gh run cancel -R "$GITHUB_REPOSITORY" "$id" || true; done; done
+              sleep 20; git pull -q --rebase
+              if [ "$ACTION" = cutover ]; then
+                node .github/scrub-public.mjs data 2>&1 | tee check.log
+                bash .github/private-data.sh check 2>&1 | tee -a check.log              # every file copied and read back identical, or stop here
+                bash .github/private-cutover.sh cutover 2>&1 | tee -a check.log
+              else
+                bash .github/private-cutover.sh rollback 2>&1 | tee check.log
+              fi
+              git commit -qm "privacy $ACTION (owner approved; private-data-check.yml)"
+              ok=0; for i in 1 2 3 4 5; do if git pull -q --rebase && git push -q; then ok=1; break; fi; git rebase --abort 2>/dev/null || true; sleep 10; done
+              [ "$ok" = 1 ] || { echo "private data: Error: could not push the $ACTION commit" | tee -a check.log; exit 1; }
+              [ "$ACTION" = cutover ] && bash .github/private-data.sh verify 2>&1 | tee -a check.log
+              gh workflow run bot.yml -R "$GITHUB_REPOSITORY" --ref main || true
+              echo "private data: $ACTION DONE" | tee -a check.log ;;
+            *) echo "private data: Error: unknown action $ACTION" | tee check.log; exit 1 ;;
+          esac
       - if: always()
         env:
           TG_TOKEN: ${{ secrets.TG_TOKEN }}
           TG_CHAT: ${{ secrets.TG_CHAT }}
           OK: ${{ steps.c.outcome }}
         run: |
-          L=$(grep -E "of .* private files|expires|Error" check.log 2>/dev/null | head -3 | cut -c1-200 | tr '\n' ' ')
-          if [ "$OK" = success ]; then T="PRIVATE DATA CONNECTION: PASSED. $L Nothing switched yet: production still reads the public repository."; else T="PRIVATE DATA CONNECTION: FAILED. $L Nothing changed. Send this message to Claude."; fi
+          L=$(grep -E "of .* private files|expires|WARNING|Error|DONE|tracked" check.log 2>/dev/null | head -4 | sed 's/^private data: //' | cut -c1-200 | tr '\n' ' ')
+          if [ "$ACTION" = verify ] && [ "$OK" = success ] && ! grep -q WARNING check.log; then exit 0; fi   # daily verify: quiet when all is well
+          A=$(echo "$ACTION" | tr a-z A-Z)
+          if [ "$OK" = success ]; then T="PRIVATE DATA $A: PASSED. $L"; else T="PRIVATE DATA $A: FAILED. $L Send this message to Claude."; fi
