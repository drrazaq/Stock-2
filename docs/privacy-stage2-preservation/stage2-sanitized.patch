diff --git a/.github/scrub-public.mjs b/.github/scrub-public.mjs
new file mode 100644
index 0000000..088bd09
--- /dev/null
+++ b/.github/scrub-public.mjs
@@ -0,0 +1,38 @@
+// Privacy cutover helper (private data migration, 28 Oct 2026). Run ONCE in the cutover commit, before the private files stop being
+// tracked: moves the owner-revealing parts of public files into their private files (listed in .github/private-files.txt) and leaves
+// the public files without them. From then on the scripts write those parts to the private files themselves (scan.mjs withPV / PV_FILE,
+// squad29-lab.mjs PRIV_HOLD, hold-lab.mjs OWNER_OUT), so this never needs to run again. Idempotent. Prints counts only.
+//   signals.json        posVerdict            -> pos-verdict.json
+//   squad29-lab.json    holdings              -> squad29-holdings.json (flags-today: holdings too; every flag loses its 'held' mark)
+//   hold-lab.json       owner, diagnostics.owner -> hold-lab-owner.json
+// Usage: node .github/scrub-public.mjs [dataDir]     Test: test/private-data.test.mjs
+import fs from 'node:fs';
+import path from 'node:path';
+
+const D = process.argv[2] || 'data', P = (f) => path.join(D, f);
+const J = (f) => { try { return JSON.parse(fs.readFileSync(P(f), 'utf8')); } catch (e) { return null; } };
+const W = (f, o) => fs.writeFileSync(P(f), JSON.stringify(o));
+const out = [];
+
+const sg = J('signals.json');
+if (sg && sg.posVerdict) { if (!J('pos-verdict.json')) W('pos-verdict.json', { generatedAt: sg.generatedAt, session: sg.session, posVerdict: sg.posVerdict }); delete sg.posVerdict; W('signals.json', sg); out.push('signals.json: posVerdict moved'); }
+
+const note = { note: 'the holdings check is private (data/squad29-holdings.json)' };
+const lab = J('squad29-lab.json'), today = J('squad29-flags-today.json');
+const hold = (lab && lab.holdings && lab.holdings.positions) ? lab.holdings : (today && today.holdings && today.holdings.positions) ? today.holdings : null;
+if (hold && !J('squad29-holdings.json')) W('squad29-holdings.json', hold);
+for (const [f, o] of [['squad29-lab.json', lab], ['squad29-flags-today.json', today]]) {
+  if (!o) continue; let n = 0;
+  if (o.holdings && o.holdings.positions) { o.holdings = { checkedAt: o.holdings.checkedAt, ...note }; n++; }
+  for (const r of o.flags || []) if (r && r.held) { r.held = null; n++; }
+  if (n) { W(f, o); out.push(f + ': ' + n + ' owner marks removed'); }
+}
+
+const hl = J('hold-lab.json');
+if (hl && (Array.isArray(hl.owner) || (hl.diagnostics && Array.isArray(hl.diagnostics.owner)))) {
+  if (!J('hold-lab-owner.json')) W('hold-lab-owner.json', { generatedAt: hl.generatedAt, owner: Array.isArray(hl.owner) ? hl.owner : [], buys: (hl.diagnostics && hl.diagnostics.owner) || [] });
+  const n = Array.isArray(hl.owner) ? hl.owner.length : 0;
+  hl.owner = { private: 'data/hold-lab-owner.json', n }; if (hl.diagnostics && Array.isArray(hl.diagnostics.owner)) hl.diagnostics.owner = hl.diagnostics.owner.length;
+  W('hold-lab.json', hl); out.push('hold-lab.json: owner section moved');
+}
+console.log('scrub: ' + (out.join('; ') || 'nothing to move'));
