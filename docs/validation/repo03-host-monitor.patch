+// Companion REPO-03 regression. PR6's source/fixtures/tests stay unchanged.
+import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs';import path from 'node:path';
+import {producerFixture} from './native-sec-producer-fixture.mjs';import {v2HostFixture} from './sec-v2-host-fixture.mjs';import {startInactiveV2Host} from '../sec-v2-host-binding.mjs';
+import {prepareNativeParentForHost} from '../native-sec-colocated-host.mjs';import {createSameDayLineageClient} from '../native-sec-lineage-history.mjs';
+import {createHash} from 'node:crypto';const sha=b=>createHash('sha256').update(b).digest('hex');
+for(const refusal of [false,true])test('actual host monitor '+(refusal?'records non-sensitive permission failure without stopping producer':'survives transient marker disappearance and retains intended partial manifest'),async t=>{
+ const p=await producerFixture({long:true,snapshotDelayMs:1,selectionTelemetry:true,symbol:'AMD',peerSymbol:'INTC',syntheticSECOrigin:true,emptyFeedBefore:Date.parse('2026-11-05T14:30:30Z')}),w=v2HostFixture(p,'manifest-partial');t.after(()=>{p.close();w.cleanup();});
