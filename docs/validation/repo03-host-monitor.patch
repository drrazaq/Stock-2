+// Actual host storage walker: real disposable paths and narrowly injected filesystem races.
+import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs';import os from 'node:os';import path from 'node:path';
+import {pathToFileURL} from 'node:url';
+const {treeBytes,HOST_CAPS}=await import(process.env.STOCK2_HOST_BUDGET_MODULE?pathToFileURL(process.env.STOCK2_HOST_BUDGET_MODULE).href:new URL('../native-sec-colocated-host.mjs',import.meta.url).href);
+function fixture(t){const root=fs.mkdtempSync(path.join(os.tmpdir(),'repo03-host-budget-'));t.after(()=>fs.rmSync(root,{recursive:true,force:true}));fs.writeFileSync(path.join(root,'evidence'),'retained');return root;}
+for(const marker of ['.observing','.writer-lock'])for(const boundary of ['stat','read'])test('normal '+marker+' removal at '+boundary+' cannot kill capture storage inspection',t=>{const root=fixture(t),file=path.join(root,marker);fs.mkdirSync(file);const original=boundary==='stat'?fs.lstatSync:fs.readdirSync,key=boundary==='stat'?'lstatSync':'readdirSync';let removed=false;fs[key]=function(p,...args){if(p===file&&!removed){removed=true;fs.rmdirSync(file);}return original.call(this,p,...args);};try{assert.equal(treeBytes(root),8);assert.equal(removed,true);}finally{fs[key]=original;}});
+test('a disappearing committed file is still an integrity failure',t=>{const root=fixture(t),file=path.join(root,'evidence'),original=fs.lstatSync;fs.lstatSync=function(p,...args){if(p===file)fs.unlinkSync(file);return original.call(this,p,...args);};try{assert.throws(()=>treeBytes(root),{code:'ENOENT'});}finally{fs.lstatSync=original;}});
+test('marker names do not bypass symlink/type/budget or permission failures',t=>{const root=fixture(t),marker=path.join(root,'.observing');fs.symlinkSync(path.join(root,'evidence'),marker);assert.throws(()=>treeBytes(root),/HOST_STORAGE_SYMLINK/);fs.unlinkSync(marker);fs.mkdirSync(marker);const original=fs.lstatSync;fs.lstatSync=function(p,...args){if(p===marker)throw Object.assign(Error('synthetic permission refusal'),{code:'EACCES'});return original.call(this,p,...args);};try{assert.throws(()=>treeBytes(root),{code:'EACCES'});}finally{fs.lstatSync=original;}fs.rmdirSync(marker);const fd=fs.openSync(marker,'wx');try{fs.ftruncateSync(fd,HOST_CAPS.storageBytes+1);}finally{fs.closeSync(fd);}assert.throws(()=>treeBytes(root),/HOST_STORAGE_BUDGET/);});
