+// Companion REPO-03 regression. PR6's source/fixtures/tests stay unchanged.
+import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs';import path from 'node:path';
+import {producerFixture} from './native-sec-producer-fixture.mjs';import {v2HostFixture} from './sec-v2-host-fixture.mjs';import {startInactiveV2Host} from '../sec-v2-host-binding.mjs';
+import {prepareNativeParentForHost} from '../native-sec-colocated-host.mjs';import {createSameDayLineageClient} from '../native-sec-lineage-history.mjs';
+import {createHash} from 'node:crypto';const sha=b=>createHash('sha256').update(b).digest('hex');
+test('actual host survives transient marker disappearance and retains the intended partial manifest',async t=>{
+ const p=await producerFixture({long:true,snapshotDelayMs:1,selectionTelemetry:true,symbol:'AMD',peerSymbol:'INTC',syntheticSECOrigin:true,emptyFeedBefore:Date.parse('2026-11-05T14:30:30Z')}),w=v2HostFixture(p,'manifest-partial');t.after(()=>{p.close();w.cleanup();});
+ const client=createSameDayLineageClient({token:'SYNTHETIC',storageOrigins:['https://synthetic.blob.core.windows.net'],fetcher:async()=>Response.json({total_count:0,workflow_runs:[]})});
+ const parentState=await prepareNativeParentForHost({client,scope:{day:'2026-11-05',before:'2026-11-05T14:29:30Z',currentRunId:900,workflowId:7,allowedSourceShas:[p.sourceSha]},rootDirectory:p.dir,destination:'runtime/native-sec-parents/repo03'});
+ const original=fs.lstatSync;let injected=0,host;fs.lstatSync=function(file,...args){if(injected===0&&String(file).startsWith(w.c.output+path.sep)&&['.observing','.writer-lock'].includes(path.basename(String(file)))&&fs.existsSync(file)){injected++;throw Object.assign(Error('SYNTHETIC_REMOVED_BETWEEN_LIST_AND_STAT'),{code:'ENOENT'});}return original.call(this,file,...args);};
+ try{
+  const result=await p.run({shadow:true,runId:'900',epoch:Date.parse('2026-11-05T14:28:00Z'),fakeMin:569,launch:spec=>{const runtimeFiles=Object.fromEntries(fs.readdirSync(p.dir).filter(n=>n.endsWith('.mjs')||n.endsWith('.js')).map(n=>[n,sha(fs.readFileSync(path.join(p.dir,n)))]));host=startInactiveV2Host({mode:'INACTIVE_SYNTHETIC_REHEARSAL',producer:{...spec,entrySha256:runtimeFiles['ignition-watch.mjs'],runtimeFiles},capture:w.capture,native:w.native,parentState,planPin:w.planPin,clock:{now:()=>Date.parse(w.c.plan.start)-30000,sleep:ms=>new Promise(r=>setTimeout(r,Math.min(ms,1000))),setTimeout,clearTimeout},storageRoot:w.f.dir,healthFile:path.join(w.f.dir,'health.json')});return host.producer;}});
+  const health=await host.completion;assert.equal(injected,1);assert.equal(health.producerExitCode,0);assert.equal(health.producerCancelled,false);assert.equal(health.status,'CAPTURE_FAILED');assert.equal(health.captureExitSignal,null,'intended manifest failure, not a resource-monitor termination');assert.deepEqual(result.snapshot.heartbeat.map(x=>x.m),Array.from({length:332},(_,i)=>569+i));assert.equal(fs.readFileSync(path.join(w.c.receiptDirectory,'manifest.json')).length,12);assert.equal(fs.readdirSync(w.c.downloads).length,41);
+ }finally{fs.lstatSync=original;}
+});
diff --git a/test/repo03-host-storage.test.mjs b/test/repo03-host-storage.test.mjs
