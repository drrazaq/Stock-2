+   const reader=r.body.getReader(),parts=[];let n=0;try{for(;;){const {done,value}=await reader.read();if(done)break;n+=value.length;receivedBytes+=value.length;need(n<=max&&receivedBytes<=PARENT_CAPS.bytes,'PARENT_RESPONSE_BUDGET');parts.push(Buffer.from(value));}}finally{await reader.cancel().catch(()=>{});}const bytes=Buffer.concat(parts);return binary?bytes:captureJson(bytes.toString());})();
+  try{return await Promise.race([operation,new Promise((_,reject)=>timer=setTimeout(()=>{controller.abort();reject(Error('PARENT_TIMEOUT'));},Math.min(timeoutMs,Math.max(1,90000-(now()-start)))))]);}finally{clearTimeout(timer);controller.abort();}
+ }
