+export function startColocatedNativeHost({mode,producer,capture,native,healthFile,parentState,completeRun=null,captureMs=HOST_CAPS.captureMs,storageRoot=capture.cwd,wait=ms=>new Promise(r=>setTimeout(r,ms))}){
+ need(mode==='INACTIVE_SYNTHETIC_REHEARSAL','HOST_INACTIVE_NO_LIVE_AUTHORIZATION');need(captureMs>0&&captureMs<=HOST_CAPS.captureMs,'HOST_TIME_BUDGET');verify(producer);verify(capture);need(path.isAbsolute(storageRoot)&&capture.cwd.startsWith(path.resolve(storageRoot)+path.sep),'HOST_STORAGE_ROOT');need(Object.keys(producer.runtimeFiles||{}).length>0&&Object.keys(capture.runtimeFiles||{}).length>0,'HOST_COMPLETE_DEPENDENCY_PINS');need(path.resolve(healthFile).startsWith(path.resolve(storageRoot)+path.sep)&&!fs.existsSync(healthFile),'HOST_EXCLUSIVE_HEALTH');for(let p=path.dirname(path.resolve(healthFile));;p=path.dirname(p)){if(fs.existsSync(p))need(!fs.lstatSync(p).isSymbolicLink(),'HOST_HEALTH_SYMLINK');if(path.dirname(p)===p)break;}
+ const launch=spec=>spawn(process.execPath,[spec.entry,...(spec.args||[])],{cwd:spec.cwd,env:{PATH:process.env.PATH,...spec.env},stdio:['ignore','pipe','pipe']});
+ if(parentState?.status==='VERIFIED_AVAILABLE_PARENT_NOT_GLOBAL_HISTORY'){need(immutableRead(parentState.manifestFile,8192).hash===parentState.manifestSha256,'HOST_PARENT_PIN');producer={...producer,env:{...producer.env,IG_NATIVE_SEC_PARENT_FILE:parentState.manifestFile,IG_NATIVE_SEC_PARENT_SHA256:parentState.manifestSha256}};}const producerChild=launch(producer);let producerCode=null,producerDone=false,producerBytes=0,captureBytes=0,captureChild=null,health='STARTED',limitHit=false;
