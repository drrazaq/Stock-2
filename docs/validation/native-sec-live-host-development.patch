+export function createNativeParentClient({fetcher,token,storageOrigins,now=()=>Date.now(),timeoutMs=PARENT_CAPS.timeoutMs}){
+ need(typeof fetcher==='function'&&typeof token==='string'&&Array.isArray(storageOrigins)&&storageOrigins.every(x=>new URL(x).origin===x&&x.startsWith('https://'))&&Number.isInteger(timeoutMs)&&timeoutMs>0&&timeoutMs<=10000,'PARENT_EXPLICIT_CLIENT_REQUIRED');
