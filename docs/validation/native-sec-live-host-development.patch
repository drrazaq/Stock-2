+ const r=await gate.perform('native-sec-complete-run-v1',[file],path.dirname(file),{retentionDays:7});need(immutableRead(file,12*1024*1024).hash===original.hash,'NATIVE_PUBLISH_MUTATED');need(Number.isSafeInteger(r.id)&&r.id>0&&Number.isInteger(r.size)&&r.size>0&&r.size<=16*1024*1024&&/^[a-f0-9]{64}$/.test(r.digest||''),'NATIVE_PUBLISH_ACK_UNKNOWN');return {artifactId:r.id,archiveSha256:r.digest,archiveBytes:r.size,fileSha256:original.hash,retentionDays:7,globalHistoryEstablished:false};
