# NON-ACTIVE PREFLIGHT REVISION. Not the earlier reviewed deployment file; requires explicit review/approval.
name: One-session premarket research validation
run-name: Phase A 2026-10-30 / 7dd702d
on:
  workflow_dispatch:
    inputs:
      approval_json:
        description: Owner-approved expiring RESEARCH_ONLY manifest (no credentials)
        required: true
        type: string
permissions:
  contents: read
concurrency:
  group: premarket-research-validation
  cancel-in-progress: false
jobs:
  collect:
    runs-on: ubuntu-latest
    timeout-minutes: 360
    steps:
      - uses: actions/checkout@v4
        with:
          ref: 7dd702d5d2ed3578f7558bc4f7fcc211f3619669
          path: code
          persist-credentials: false
          sparse-checkout-cone-mode: false
          sparse-checkout: |
            /research-collector.mjs
            /market-session.mjs
            /market-symbol.mjs
            /snapshot-fields.mjs
            /discovery-runtime.mjs
            /multi-angle-discovery.mjs
            /ignition-gates.mjs
            /tools/research-collector.mjs
            /tools/seal-research-artifact.mjs
      - name: Enforce the single dated attempt before binding provider secrets
        env:
          APPROVED_MANIFEST: ${{ inputs.approval_json }}
        run: |
          python - <<'PY'
          import json,os,pathlib,urllib.request
          # BEGIN_SCOPE_RULES
          """Pure preflight rules for the proposed one-day wrapper, not an activation tool."""
          from datetime import datetime, timezone
          from zoneinfo import ZoneInfo
          import math

          SOURCE = "7dd702d5d2ed3578f7558bc4f7fcc211f3619669"
          SESSION_DAY = "2026-10-30"
          RUN_TITLE = "Phase A 2026-10-30 / 7dd702d"


          def check_session(manifest, history, now, run_id, attempt):
              if str(attempt) != "1":
                  raise ValueError("RERUN_NOT_AUTHORIZED")
              if not isinstance(manifest, dict) or manifest.get("mode") != "RESEARCH_ONLY" or manifest.get("sourceSha") != SOURCE or manifest.get("sessionDay") != SESSION_DAY:
                  raise ValueError("SESSION_SCOPE_MISMATCH")
              for field, expected in [("maxCycles", 330), ("maxRequests", 420), ("maxCompressedBytes", 67108864)]:
                  if type(manifest.get(field)) is not int or manifest[field] != expected:
                      raise ValueError("SESSION_BUDGET_MISMATCH")
              approved = datetime.fromisoformat(manifest["approvedAt"].replace("Z", "+00:00"))
              expires = datetime.fromisoformat(manifest["expiresAt"].replace("Z", "+00:00"))
              if approved.tzinfo is None or expires.tzinfo is None or now.tzinfo is None:
                  raise ValueError("TIMEZONE_REQUIRED")
              expected_expiry = datetime(2026, 10, 30, 13, 35, tzinfo=timezone.utc)
              if not approved <= now < expires or (expires - approved).total_seconds() > 86400 or expires != expected_expiry:
                  raise ValueError("APPROVAL_WINDOW_INVALID")
              local = now.astimezone(ZoneInfo("America/New_York"))
              if local.date().isoformat() != SESSION_DAY or not 235 <= local.hour * 60 + local.minute <= 240:
                  raise ValueError("OUTSIDE_APPROVED_START_WINDOW")
              if not isinstance(history, dict) or type(history.get("total_count")) is not int or not 1 <= history["total_count"] <= 100 or not isinstance(history.get("workflow_runs"), list) or len(history["workflow_runs"]) != history["total_count"]:
                  raise ValueError("RUN_HISTORY_NOT_EXHAUSTIVE")
              matches = [r for r in history["workflow_runs"] if isinstance(r, dict) and r.get("display_title") == RUN_TITLE]
              if not matches or any(type(r.get("id")) is not int or r["id"] <= 0 for r in matches):
                  raise ValueError("RUN_IDENTITY_UNVERIFIED")
              first = min(matches, key=lambda r: r["id"])
              if first["id"] != int(run_id) or first.get("run_attempt") != 1:
                  raise ValueError("SESSION_ALREADY_ATTEMPTED")
              return {"sessionDay": SESSION_DAY, "sourceSha": SOURCE, "runId": int(run_id), "attempt": 1, "status": "WRAPPER_SCOPE_VERIFIED"}


          def evaluate_collection(summary, cycles):
              """Fails the validation job on incomplete coverage; never approves a strategy."""
              problems = []
              if not isinstance(summary, dict) or not isinstance(cycles, list):
                  return {"status": "VALIDATION_FAILED", "problems": ["MALFORMED_COLLECTION_EVIDENCE"], "approvedBuy": False}
              if summary.get("sourceSha") != SOURCE or summary.get("executionWindowComplete") is not True or summary.get("uniqueMinutes") != 330 or summary.get("cycles") != 330 or len(cycles) != 330:
                  problems.append("INCOMPLETE_EXECUTION_WINDOW")
              if type(summary.get("requests")) is not int or not 0 <= summary["requests"] <= 420 or type(summary.get("bytes")) is not int or not 0 <= summary["bytes"] <= 67108864:
                  problems.append("BUDGET_EVIDENCE_INVALID")
              minutes, latencies, observed, usable = set(), [], 0, 0
              for row in cycles:
                  if not isinstance(row, dict):
                      problems.append("MALFORMED_CYCLE_EVIDENCE")
                      continue
                  claims = row.get("claims")
                  if row.get("kind") != "RESEARCH_ONLY" or not isinstance(claims, dict) or claims.get("orders") is not False or claims.get("approvedBuy") is not False:
                      problems.append("UNEXPECTED_COLLECTION_SCOPE")
                  session = row.get("session")
                  if not isinstance(session, dict) or session.get("day") != SESSION_DAY or type(session.get("minute")) is not int or not 240 <= session["minute"] < 570:
                      problems.append("UNEXPECTED_OBSERVATION_MINUTE")
                  else:
                      minutes.add(session["minute"])
                  metrics = row.get("metrics")
                  if not isinstance(metrics, dict):
                      problems.append("MALFORMED_PRICE_EVIDENCE")
                  else:
                      symbols, fresh = metrics.get("uniqueSymbols"), metrics.get("freshPrices")
                      if type(symbols) is not int or type(fresh) is not int or not 0 <= fresh <= symbols <= 30000:
                          problems.append("MALFORMED_PRICE_EVIDENCE")
                      elif symbols >= 10000 and fresh > 0:
                          usable += 1
                  providers = row.get("providers")
                  if not isinstance(providers, list) or any(not isinstance(p, dict) for p in providers):
                      problems.append("MALFORMED_PROVIDER_EVIDENCE")
                      continue
                  snapshots = [p for p in providers if p.get("provider") == "MASSIVE_FULL_SNAPSHOT"]
                  if len(snapshots) != 1:
                      problems.append("MISSING_OR_DUPLICATE_SNAPSHOT_EVIDENCE")
                      continue
                  provider = snapshots[0]
                  if provider.get("status") == "RESPONSE_OBSERVED":
                      observed += 1
                  latency = provider.get("requestLatencyMs")
                  if type(latency) in (int, float) and math.isfinite(latency) and latency >= 0:
                      latencies.append(latency)
                  else:
                      problems.append("MALFORMED_LATENCY_EVIDENCE")
              if minutes != set(range(240, 570)):
                  problems.append("MISSING_OR_DUPLICATE_CLOCK_MINUTES")
              if usable < 314:
                  problems.append("BROAD_SNAPSHOT_WITH_SOME_FRESH_DATA_BELOW_95_PERCENT")
              if observed < 314:
                  problems.append("SNAPSHOT_VALID_RESPONSE_RATE_BELOW_95_PERCENT")
              if len(latencies) != 330 or sorted(latencies)[math.ceil(len(latencies) * .95) - 1] >= 10000:
                  problems.append("REQUEST_LATENCY_NOT_ESTABLISHED_BELOW_10_SECONDS")
              return {"status": "COLLECTION_CHECKS_PASSED_ONLY" if not problems else "VALIDATION_FAILED", "problems": sorted(set(problems)), "tradableUniverseCoverage": "UNVERIFIED", "profitability": "NOT_TESTED", "approvedBuy": False}
          # END_SCOPE_RULES
          if os.environ.get('GITHUB_RUN_ATTEMPT')!='1': raise ValueError('RERUN_NOT_AUTHORIZED')
          if os.environ.get('GITHUB_REPOSITORY')!='drrazaq/Stock-2' or os.environ.get('GITHUB_REF')!='refs/heads/main' or os.environ.get('GITHUB_EVENT_NAME')!='workflow_dispatch': raise ValueError('MAIN_MANUAL_SESSION_ONLY')
          u='https://api.github.com/repos/drrazaq/Stock-2/actions/workflows/premarket-research-validation.yml/runs?event=workflow_dispatch&per_page=100'
          req=urllib.request.Request(u,headers={'Accept':'application/vnd.github+json','User-Agent':'Stock2-phase-a-preflight','Cache-Control':'no-cache'})
          with urllib.request.urlopen(req,timeout=15) as r: raw=r.read(2097153)
          if len(raw)>2097152: raise ValueError('RUN_HISTORY_TOO_LARGE')
          report=check_session(json.loads(os.environ['APPROVED_MANIFEST']),json.loads(raw),datetime.now(timezone.utc),os.environ['GITHUB_RUN_ID'],os.environ['GITHUB_RUN_ATTEMPT'])
          pathlib.Path('code/phase-a-wrapper-preflight.json').write_text(json.dumps(report))
          print(json.dumps(report))
          PY
      - uses: actions/checkout@v4
        with:
          ref: main
          path: public-inputs
          persist-credentials: false
          sparse-checkout-cone-mode: false
          sparse-checkout: |
            /data/news-log.jsonl
            /data/events-recent.json
            /data/insider-study.json
            /data/earnings-recent.json
            /data/chain-ripple.json
            /data/share-supply.json
            /data/discovery2-today.json
            /data/comeback-today.json
      - uses: actions/setup-node@v4
        with:
          node-version: '20'
      - name: Stage only public research inputs and record provenance
        env:
          APPROVED_MANIFEST: ${{ inputs.approval_json }}
        run: |
          python - <<'PY'
          import json,os,pathlib,shutil,subprocess
          p=pathlib.Path('code');(p/'data').mkdir(exist_ok=True);(p/'research-output').mkdir(exist_ok=True)
          names=['news-log.jsonl','events-recent.json','insider-study.json','earnings-recent.json','chain-ripple.json','share-supply.json','discovery2-today.json','comeback-today.json']
          for n in names:
            src=pathlib.Path('public-inputs/data')/n
            if src.is_file(): shutil.copyfile(src,p/'data'/n)
          sha=subprocess.run(['git','-C','public-inputs','rev-parse','HEAD'],check=True,capture_output=True,text=True).stdout.strip()
          (p/'research-output/input-source.json').write_text(json.dumps({'sourceSha':'7dd702d5d2ed3578f7558bc4f7fcc211f3619669','inputSha':sha,'allowedFiles':names}))
          (p/'approved-manifest.json').write_text(json.dumps(json.loads(os.environ['APPROVED_MANIFEST'])))
          PY
      - name: Verify encryption before any provider request
        working-directory: code
        env:
          RESEARCH_ARTIFACT_KEY: ${{ secrets.RESEARCH_ARTIFACT_KEY }}
        run: |
          node --input-type=module - <<'JS'
          import {sealResearch,openResearch} from './tools/seal-research-artifact.mjs';
          const input=Buffer.from('preflight fixture'),sealed=sealResearch(input,process.env.RESEARCH_ARTIFACT_KEY,{sourceSha:'7dd702d5d2ed3578f7558bc4f7fcc211f3619669',path:'preflight'});
          if(!openResearch(sealed,process.env.RESEARCH_ARTIFACT_KEY).equals(input))throw Error('encryption preflight failed');
          console.log('Encryption roundtrip verified; no provider request performed');
          JS
      - name: Collect research only (no Telegram or broker bindings)
        id: collection
        working-directory: code
        env:
          STOCK2_SOURCE_SHA: 7dd702d5d2ed3578f7558bc4f7fcc211f3619669
          MASSIVE_KEY: ${{ secrets.MASSIVE_KEY }}
          FINNHUB_KEY: ${{ secrets.FINNHUB_KEY }}
        run: timeout --signal=TERM --kill-after=15s 340m node tools/research-collector.mjs --collect approved-manifest.json
      - name: Evaluate actual collection before calling validation successful
        if: always() && steps.collection.outcome != 'skipped'
        working-directory: code
        run: |
          python - <<'PY'
          import json,gzip,pathlib
          # BEGIN_SCOPE_RULES
          """Pure preflight rules for the proposed one-day wrapper, not an activation tool."""
          from datetime import datetime, timezone
          from zoneinfo import ZoneInfo
          import math

          SOURCE = "7dd702d5d2ed3578f7558bc4f7fcc211f3619669"
          SESSION_DAY = "2026-10-30"
          RUN_TITLE = "Phase A 2026-10-30 / 7dd702d"


          def check_session(manifest, history, now, run_id, attempt):
              if str(attempt) != "1":
                  raise ValueError("RERUN_NOT_AUTHORIZED")
              if not isinstance(manifest, dict) or manifest.get("mode") != "RESEARCH_ONLY" or manifest.get("sourceSha") != SOURCE or manifest.get("sessionDay") != SESSION_DAY:
                  raise ValueError("SESSION_SCOPE_MISMATCH")
              for field, expected in [("maxCycles", 330), ("maxRequests", 420), ("maxCompressedBytes", 67108864)]:
                  if type(manifest.get(field)) is not int or manifest[field] != expected:
                      raise ValueError("SESSION_BUDGET_MISMATCH")
              approved = datetime.fromisoformat(manifest["approvedAt"].replace("Z", "+00:00"))
              expires = datetime.fromisoformat(manifest["expiresAt"].replace("Z", "+00:00"))
              if approved.tzinfo is None or expires.tzinfo is None or now.tzinfo is None:
                  raise ValueError("TIMEZONE_REQUIRED")
              expected_expiry = datetime(2026, 10, 30, 13, 35, tzinfo=timezone.utc)
              if not approved <= now < expires or (expires - approved).total_seconds() > 86400 or expires != expected_expiry:
                  raise ValueError("APPROVAL_WINDOW_INVALID")
              local = now.astimezone(ZoneInfo("America/New_York"))
              if local.date().isoformat() != SESSION_DAY or not 235 <= local.hour * 60 + local.minute <= 240:
                  raise ValueError("OUTSIDE_APPROVED_START_WINDOW")
              if not isinstance(history, dict) or type(history.get("total_count")) is not int or not 1 <= history["total_count"] <= 100 or not isinstance(history.get("workflow_runs"), list) or len(history["workflow_runs"]) != history["total_count"]:
                  raise ValueError("RUN_HISTORY_NOT_EXHAUSTIVE")
              matches = [r for r in history["workflow_runs"] if isinstance(r, dict) and r.get("display_title") == RUN_TITLE]
              if not matches or any(type(r.get("id")) is not int or r["id"] <= 0 for r in matches):
                  raise ValueError("RUN_IDENTITY_UNVERIFIED")
              first = min(matches, key=lambda r: r["id"])
              if first["id"] != int(run_id) or first.get("run_attempt") != 1:
                  raise ValueError("SESSION_ALREADY_ATTEMPTED")
              return {"sessionDay": SESSION_DAY, "sourceSha": SOURCE, "runId": int(run_id), "attempt": 1, "status": "WRAPPER_SCOPE_VERIFIED"}


          def evaluate_collection(summary, cycles):
              """Fails the validation job on incomplete coverage; never approves a strategy."""
              problems = []
              if not isinstance(summary, dict) or not isinstance(cycles, list):
                  return {"status": "VALIDATION_FAILED", "problems": ["MALFORMED_COLLECTION_EVIDENCE"], "approvedBuy": False}
              if summary.get("sourceSha") != SOURCE or summary.get("executionWindowComplete") is not True or summary.get("uniqueMinutes") != 330 or summary.get("cycles") != 330 or len(cycles) != 330:
                  problems.append("INCOMPLETE_EXECUTION_WINDOW")
              if type(summary.get("requests")) is not int or not 0 <= summary["requests"] <= 420 or type(summary.get("bytes")) is not int or not 0 <= summary["bytes"] <= 67108864:
                  problems.append("BUDGET_EVIDENCE_INVALID")
              minutes, latencies, observed, usable = set(), [], 0, 0
              for row in cycles:
                  if not isinstance(row, dict):
                      problems.append("MALFORMED_CYCLE_EVIDENCE")
                      continue
                  claims = row.get("claims")
                  if row.get("kind") != "RESEARCH_ONLY" or not isinstance(claims, dict) or claims.get("orders") is not False or claims.get("approvedBuy") is not False:
                      problems.append("UNEXPECTED_COLLECTION_SCOPE")
                  session = row.get("session")
                  if not isinstance(session, dict) or session.get("day") != SESSION_DAY or type(session.get("minute")) is not int or not 240 <= session["minute"] < 570:
                      problems.append("UNEXPECTED_OBSERVATION_MINUTE")
                  else:
                      minutes.add(session["minute"])
                  metrics = row.get("metrics")
                  if not isinstance(metrics, dict):
                      problems.append("MALFORMED_PRICE_EVIDENCE")
                  else:
                      symbols, fresh = metrics.get("uniqueSymbols"), metrics.get("freshPrices")
                      if type(symbols) is not int or type(fresh) is not int or not 0 <= fresh <= symbols <= 30000:
                          problems.append("MALFORMED_PRICE_EVIDENCE")
                      elif symbols >= 10000 and fresh > 0:
                          usable += 1
                  providers = row.get("providers")
                  if not isinstance(providers, list) or any(not isinstance(p, dict) for p in providers):
                      problems.append("MALFORMED_PROVIDER_EVIDENCE")
                      continue
                  snapshots = [p for p in providers if p.get("provider") == "MASSIVE_FULL_SNAPSHOT"]
                  if len(snapshots) != 1:
                      problems.append("MISSING_OR_DUPLICATE_SNAPSHOT_EVIDENCE")
                      continue
                  provider = snapshots[0]
                  if provider.get("status") == "RESPONSE_OBSERVED":
                      observed += 1
                  latency = provider.get("requestLatencyMs")
                  if type(latency) in (int, float) and math.isfinite(latency) and latency >= 0:
                      latencies.append(latency)
                  else:
                      problems.append("MALFORMED_LATENCY_EVIDENCE")
              if minutes != set(range(240, 570)):
                  problems.append("MISSING_OR_DUPLICATE_CLOCK_MINUTES")
              if usable < 314:
                  problems.append("BROAD_SNAPSHOT_WITH_SOME_FRESH_DATA_BELOW_95_PERCENT")
              if observed < 314:
                  problems.append("SNAPSHOT_VALID_RESPONSE_RATE_BELOW_95_PERCENT")
              if len(latencies) != 330 or sorted(latencies)[math.ceil(len(latencies) * .95) - 1] >= 10000:
                  problems.append("REQUEST_LATENCY_NOT_ESTABLISHED_BELOW_10_SECONDS")
              return {"status": "COLLECTION_CHECKS_PASSED_ONLY" if not problems else "VALIDATION_FAILED", "problems": sorted(set(problems)), "tradableUniverseCoverage": "UNVERIFIED", "profitability": "NOT_TESTED", "approvedBuy": False}
          # END_SCOPE_RULES
          root=pathlib.Path('research-output')
          summaries=list(root.glob('*/summary.json'))
          if len(summaries)!=1: raise ValueError('MISSING_OR_AMBIGUOUS_SESSION_SUMMARY')
          file=summaries[0]
          summary=json.loads(file.read_text())
          cycles=[json.loads(gzip.decompress(p.read_bytes())) for p in sorted(file.parent.glob('*.json.gz'))]
          report=evaluate_collection(summary,cycles)
          (root/'validation-evaluation.json').write_text(json.dumps(report))
          print(json.dumps(report))
          if report['status']!='COLLECTION_CHECKS_PASSED_ONLY': raise SystemExit(1)
          PY
      - name: Seal artifacts before any upload
        if: always()
        working-directory: code
        env:
          STOCK2_SOURCE_SHA: 7dd702d5d2ed3578f7558bc4f7fcc211f3619669
          PRIVATE_KEY: ${{ secrets.RESEARCH_ARTIFACT_KEY }}
        run: node tools/seal-research-artifact.mjs research-output sealed-research
      - name: Upload encrypted evidence only
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: encrypted-premarket-${{ github.run_id }}-${{ github.run_attempt }}
          path: code/sealed-research/
          retention-days: 3
          if-no-files-found: error
