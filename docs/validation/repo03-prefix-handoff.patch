diff --git a/native-sec-colocated-prefix.mjs b/native-sec-colocated-prefix.mjs
index d9a36c85..40547c21 100644
--- a/native-sec-colocated-prefix.mjs
+++ b/native-sec-colocated-prefix.mjs
@@ -1,7 +1,7 @@
 // Stable immutable prefix handoff while later responses append. No cursor trust,
-// lock stealing, request, clock repair or relaxation of incomplete-file checks.
+// lock stealing, request, clock repair or inclusion of any in-flight bytes.
 import fs from 'node:fs';import path from 'node:path';import {createHash} from 'node:crypto';
-import {nativeRunDigest,nativeEventsForCapture} from './native-sec-events.mjs';import {validateNativeEvidenceAsset} from './native-sec-handoff.mjs';import {immutableRead} from './paper-capture-wrapper.mjs';
+import {nativeRunDigest,nativeEventsForCapture,NATIVE_SEC_CAPS} from './native-sec-events.mjs';import {validateNativeEvidenceAsset} from './native-sec-handoff.mjs';import {immutableRead} from './paper-capture-wrapper.mjs';
 const sha=b=>createHash('sha256').update(b).digest('hex');
 export function colocatedPrefixPort({directory,expectedRunId,expectedSourceSha,wait=ms=>new Promise(r=>setTimeout(r,ms))}){
  const delays=[10,25,50,100,200,400,400];
@@ -10,7 +10,17 @@ export function colocatedPrefixPort({directory,expectedRunId,expectedSourceSha,w
   // A newly appended immutable successor does not alter this already captured
   // chain prefix. Recheck every selected original byte, not a mutable cursor.
   for(const f of prefix.files)if(sha(immutableRead(path.join(directory,f.name),8*1024*1024).bytes)!==sha(Buffer.from(f.bodyBase64,'base64')))throw Error('COLOCATED_PREFIX_CHANGED');
-  const names=fs.readdirSync(directory);if(names.some(n=>!['run.json','lineage.json','.cursor.json'].includes(n)&&!/^response-\d{6}\.json$/.test(n)))throw Error('COLOCATED_PREFIX_INCOMPLETE');
+  const names=fs.readdirSync(directory),selected=new Set(prefix.files.map(f=>f.name)),count=prefix.files.filter(f=>/^response-\d{6}\.json$/.test(f.name)).length;
+  // The initial digest above remains STRICT: pre-existing locks/partial files
+  // never qualify. A writer that starts only AFTER that validated snapshot may
+  // append a successor without invalidating the selected immutable prefix.
+  if(names.length>NATIVE_SEC_CAPS.responses+7||[...selected].some(n=>!names.includes(n)))throw Error('COLOCATED_PREFIX_INCOMPLETE');
+  for(const n of names){
+   if(['run.json','lineage.json','.cursor.json'].includes(n)||/^response-\d{6}\.json$/.test(n))continue;
+   const successor=/^response-(\d{6})\.json\.pending-[a-f0-9]{16}$/.exec(n),cursor=/^\.cursor\.json\.pending-[a-f0-9]{16}$/.test(n);
+   if(n!=='.writer-lock'&&!cursor&&!(successor&&Number(successor[1])>=count&&Number(successor[1])<NATIVE_SEC_CAPS.responses))throw Error('COLOCATED_PREFIX_INCOMPLETE');
+   try{const stat=fs.lstatSync(path.join(directory,n));if(stat.isSymbolicLink()||(n==='.writer-lock'?!stat.isDirectory():!stat.isFile()))throw Error('COLOCATED_PREFIX_INCOMPLETE');}catch(e){if(e.code!=='ENOENT')throw e;}
+  }
   return {raw:JSON.stringify(nativeEventsForCapture(archive,{at,identities})),evidenceAssets:[asset]};
  }catch(e){if(attempt===delays.length)throw e;await wait(delays[attempt]);}};
 }
diff --git a/test/native-sec-colocated-prefix.test.mjs b/test/native-sec-colocated-prefix.test.mjs
index 9d123c23..f9bd05b9 100644
--- a/test/native-sec-colocated-prefix.test.mjs
+++ b/test/native-sec-colocated-prefix.test.mjs
@@ -1,8 +1,14 @@
 // Synthetic local immutable files only. No HTTP or original evidence reconstruction.
 import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs';import path from 'node:path';
-import {openNativeRun,appendNativeResponse} from '../native-sec-events.mjs';import {colocatedPrefixPort} from '../native-sec-colocated-prefix.mjs';
+import {openNativeRun,appendNativeResponse} from '../native-sec-events.mjs';import {pathToFileURL} from 'node:url';
+const {colocatedPrefixPort}=await import(process.env.STOCK2_PREFIX_MODULE?pathToFileURL(process.env.STOCK2_PREFIX_MODULE).href:new URL('../native-sec-colocated-prefix.mjs',import.meta.url).href);
 const source='a'.repeat(40),t=n=>new Date(Date.parse('2026-11-05T14:30:00Z')+n*60000).toISOString();
 function fixture(){const dir=fs.mkdtempSync('/tmp/colocated-prefix-'),store=openNativeRun({directory:dir,runId:'SYNTHETIC',sourceSha:source,provenance:'SYNTHETIC_FIXTURE'}),url='https://www.sec.gov/cgi-bin/browse-edgar?action=getcurrent&output=atom';const append=(n,items='1.01')=>appendNativeResponse(store,{body:Buffer.from('<feed><entry><title>8-K - SYNTHETIC (0000000001) (Filer)</title><summary>Item '+items+'</summary><updated>'+t(-1)+'</updated><id>urn:tag:sec.gov,2008:accession-number=0000000001-26-000001</id></entry></feed>'),url,responseUrl:url,redirected:false,httpStatus:200,requestStartedAt:t(n),headersReceivedAt:t(n),bodyReceivedAt:t(n),observedAt:t(n),legacySeen:new Set()});return {dir,append,read:colocatedPrefixPort({directory:dir,expectedRunId:'SYNTHETIC',expectedSourceSha:source,wait:async()=>{}}),input:{at:t(5),identities:[{issuerCik:'0000000001',symbol:'AMD',securityId:'SYNTHETIC',asOf:t(-2),identityAudit:'DOCUMENTED_SOURCE_REVIEW'}]},cleanup:()=>fs.rmSync(dir,{recursive:true,force:true})};}
 test('new immutable successor during a read does not invalidate the captured original prefix; next read retains revision and first clocks',async()=>{const f=fixture(),original=fs.readdirSync;try{f.append(0);let appended=false;fs.readdirSync=(p,...args)=>{const names=original(p,...args);if(p===f.dir&&!appended){appended=true;f.append(1,'2.02');}return names;};const first=await f.read(f.input);assert.equal(first.evidenceAssets[0].files.filter(x=>x.name.startsWith('response-')).length,1);assert.equal(JSON.parse(first.raw).events[0].firstIngestedAt,t(0));fs.readdirSync=original;const next=await f.read(f.input);assert.equal(next.evidenceAssets[0].files.filter(x=>x.name.startsWith('response-')).length,2);assert.equal(JSON.parse(next.raw).events[0].nativeEvidenceStatus,'REVISION_REQUIRES_REVIEW');assert.equal(JSON.parse(next.raw).events[0].firstIngestedAt,t(0));}finally{fs.readdirSync=original;f.cleanup();}});
 test('partial files, stale locks and changed original bytes cannot become a complete prefix',async()=>{const f=fixture();try{f.append(0);const file=path.join(f.dir,'response-000000.json'),bytes=fs.readFileSync(file);fs.writeFileSync(path.join(f.dir,'.pending-SYNTHETIC'),'partial');await assert.rejects(f.read(f.input));fs.unlinkSync(path.join(f.dir,'.pending-SYNTHETIC'));fs.mkdirSync(path.join(f.dir,'.writer-lock'));await assert.rejects(f.read(f.input));fs.rmdirSync(path.join(f.dir,'.writer-lock'));fs.writeFileSync(file,Buffer.concat([bytes,Buffer.from('corruption')]));await assert.rejects(f.read(f.input));assert.ok(fs.readFileSync(file).length>bytes.length);}finally{f.cleanup();}});
 test('legitimate in-progress commit gets bounded backoff; original clock and bytes remain unchanged',async()=>{const f=fixture(),waits=[];try{f.append(0);fs.mkdirSync(path.join(f.dir,'.writer-lock'));const read=colocatedPrefixPort({directory:f.dir,expectedRunId:'SYNTHETIC',expectedSourceSha:source,wait:async ms=>{waits.push(ms);if(waits.reduce((a,b)=>a+b,0)>=500)fs.rmdirSync(path.join(f.dir,'.writer-lock'));}}),bytes=fs.readFileSync(path.join(f.dir,'response-000000.json')),result=await read(f.input);assert.deepEqual(waits,[10,25,50,100,200,400]);assert.equal(JSON.parse(result.raw).events[0].firstIngestedAt,t(0));assert.deepEqual(fs.readFileSync(path.join(f.dir,'response-000000.json')),bytes);}finally{f.cleanup();}});
+
+for(const transient of ['.writer-lock','response-000001.json.pending-0123456789abcdef','.cursor.json.pending-0123456789abcdef'])test('validated immutable prefix survives a NEW successor phase '+transient,async()=>{const f=fixture(),original=fs.readdirSync;try{f.append(0);const bytes=fs.readFileSync(path.join(f.dir,'response-000000.json'));let calls=0;fs.readdirSync=(p,...args)=>{if(p===f.dir&&++calls===2){if(transient==='.writer-lock')fs.mkdirSync(path.join(f.dir,transient));else fs.writeFileSync(path.join(f.dir,transient),'SYNTHETIC_INCOMPLETE_SUCCESSOR');}return original(p,...args);};const result=await f.read(f.input);assert.equal(JSON.parse(result.raw).events[0].firstIngestedAt,t(0));assert.deepEqual(result.evidenceAssets[0].files.map(x=>x.name),['response-000000.json','run.json']);assert.deepEqual(fs.readFileSync(path.join(f.dir,'response-000000.json')),bytes);assert.ok(fs.existsSync(path.join(f.dir,transient)));}finally{fs.readdirSync=original;f.cleanup();}});
+for(const transient of ['response-000000.json.pending-0123456789abcdef','health-incomplete.json','unrecognized-file'])test('new evidence of selected-file rewrite or archive failure is never hidden: '+transient,async()=>{const f=fixture(),original=fs.readdirSync;try{f.append(0);let calls=0;fs.readdirSync=(p,...args)=>{if(p===f.dir&&++calls===2)fs.writeFileSync(path.join(f.dir,transient),'SYNTHETIC_FAILURE');return original(p,...args);};await assert.rejects(f.read(f.input));assert.ok(fs.existsSync(path.join(f.dir,transient)));}finally{fs.readdirSync=original;f.cleanup();}});
+
+test('a NEW successor staging symlink is refused without reading its target',async()=>{const f=fixture(),original=fs.readdirSync;try{f.append(0);let calls=0;const staged=path.join(f.dir,'response-000001.json.pending-0123456789abcdef');fs.readdirSync=(p,...args)=>{if(p===f.dir&&++calls===2)fs.symlinkSync(path.join(f.dir,'response-000000.json'),staged);return original(p,...args);};await assert.rejects(f.read(f.input));assert.equal(fs.lstatSync(staged).isSymbolicLink(),true);}finally{fs.readdirSync=original;f.cleanup();}});
