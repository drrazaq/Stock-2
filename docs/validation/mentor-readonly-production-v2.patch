+test('rejected mentor reply preserves financial evidence and ordinary offset semantics; owner may repeat read-only request',async t=>{const f=await fixture(t);f.reject();f.set('mentor ZZQ');await f.s.fn('tgCommands')(null);f.unchanged();assert.equal(f.s.readJson('data/tg-state.json').offset,102);assert.ok(f.sent.length>0);});
+for(const text of ['mentor ZZQ','mentor'])test('actual scan main fast-reply entry has no provider or financial mutation: '+text,async t=>{const f=await fixture(t);f.set(text);fs.copyFileSync(process.env.SCAN_SRC||path.join(root,'scan.mjs'),path.join(f.s.dir,'scan.mjs'));const preload=path.join(f.s.dir,'guard.mjs');fs.writeFileSync(preload,`const raw=fetch;globalThis.fetch=(u,o)=>{if(!String(u).startsWith(${JSON.stringify(f.base+'/')}))throw Error('SYNTHETIC_EXTERNAL_REQUEST_BLOCKED');return raw(u,o);};`);
+ const child=spawn(process.execPath,['scan.mjs'],{cwd:f.s.dir,env:{PATH:process.env.PATH,HOME:f.s.dir,TWELVE_KEY:'synthetic',TG_TOKEN:'synthetic',TG_CHAT:'42',TG_BASE:f.base,PRIVATE_KEY:'SYNTHETIC_MENTOR_ONLY',GITHUB_WORKFLOW:'Telegram bot replies',MODE:'chat',BOT_ONLY:'1',NODE_OPTIONS:'--import='+preload},stdio:['ignore','pipe','pipe']});let output='';child.stdout.on('data',x=>output+=x);child.stderr.on('data',x=>output+=x);const timer=setTimeout(()=>child.kill('SIGKILL'),10000);t.after(()=>clearTimeout(timer));const exit=await new Promise((resolve,reject)=>{child.on('error',reject);child.on('close',resolve);});assert.equal(exit,0,output);f.unchanged();assert.match(f.sent.join('\n'),/MENTOR/);assert.equal(f.s.readJson('data/tg-state.json').offset,102);});
