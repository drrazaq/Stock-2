+import test from 'node:test';import assert from 'node:assert/strict';
+import {leaderDipMentorPlan,renderLeaderDipMentor,captureLeaderDipContract,savedLeaderDipSignal,mentorSessionAfter} from '../mentor-plan.mjs';import {marketSession} from '../market-session.mjs';import {mentorReleaseExamples} from './mentor-release-examples.mjs';
+const source={rule:'SQ11-PB12',day:'2026-10-30',close:100,sha256:'a'.repeat(64)},position={src:'leader dip',entry:100,target:120,ldHold:126,boughtSession:'2026-11-02'};
+const plan=(x={})=>leaderDipMentorPlan({symbol:'ZZQ',position,signal:source,quantity:5,asOfDay:'2026-11-02',...x});
+test('frozen base no-target close exit remains distinct from unadopted20% overlay and full-loss allocation',()=>{const p=plan(),s=renderLeaderDipMentor(p);assert.equal(p.actionability,'NOT_ACTIONABLE');assert.equal(p.exit.baseExit,'SESSION_126_CLOSE_NO_FIXED_TARGET');assert.equal(p.exit.targetStudyAdopted,false);assert.equal(p.risk.notional,500);assert.equal(p.risk.maximumAllocationPerSlot,1000);assert.equal(p.risk.maximumSlots,3);assert.equal(p.risk.stopDefinedLossCap,null);assert.match(s,/NOT PROVEN/);assert.match(s,/can lose its full notional/);assert.match(s,/next open.*differs from the registered close/);});
+for(const [signalDay,day,open] of [['2026-10-29','2026-10-30','2026-10-30T13:30:00Z'],['2026-10-30','2026-11-02','2026-11-02T14:30:00Z']])test('registered entry expires at the actual New York open, DST preserved: '+day,()=>{const input={position:null,signal:{...source,day:signalDay},asOfDay:day},t=Date.parse(open);assert.equal(plan({...input,asOfMs:t-1000}).entry.state,'BEFORE_REGISTERED_OPEN');assert.equal(plan({...input,asOfMs:t}).entry.state,'OPEN_ONLY_TIME_AND_QUOTE_UNVERIFIED');assert.equal(plan({...input,asOfMs:t+1000}).entry.state,'EXPIRED');});
+test('legacy/missing/contradictory sources and unsupported lanes remain unresolved',()=>{for(const x of [{signal:null},{position:{...position,target:150}},{position:{...position,stop:90}},{position:{...position,ldHold:5}},{position:{...position,src:'other lane'}}]){const p=plan(x);assert.equal(p.planStatus,'UNRESOLVED');assert.equal(p.holdingState,'UNRESOLVED_PLAN_NOT_HOLD_GUIDANCE');assert.equal(p.actionability,'NOT_ACTIONABLE');}});
+test('archived contract checksum rejects mutation and is explicitly not authentication',()=>{const c=captureLeaderDipContract(source);assert.equal(c.status,'CAPTURED_SOURCE_NOT_AUTHENTICATED');assert.deepEqual(savedLeaderDipSignal(c),{...source,generatedAt:null});assert.equal(savedLeaderDipSignal({...c,hold:63}),null);assert.equal(savedLeaderDipSignal({...c,source:{...source,close:999}}),null);assert.equal(captureLeaderDipContract({...source,sha256:null}),null);});
+test('unknown calendars and mismatched clocks cannot create executable guidance',()=>{const p=plan({asOfDay:'2030-01-01'});assert.equal(p.planStatus,'UNRESOLVED');assert.equal(p.entry.state,'UNKNOWN');assert.equal(mentorSessionAfter('2030-01-01',1),null);assert.equal(plan({asOfMs:Date.parse('2026-10-30T13:30:00Z')}).entry.state,'UNKNOWN');});
+test('session126 half-day close is13:00, never silently next-open recovery or confirmed sale',()=>{const end='2026-11-27';let ms=Date.parse(end+'T12:00:00Z'),n=0;while(n<125){ms-=86400000;const s=marketSession(new Date(ms).toISOString().slice(0,10));assert.equal(s.known,true);if(!s.closed)n++;}const buy=new Date(ms).toISOString().slice(0,10);do{ms-=86400000;}while(marketSession(new Date(ms).toISOString().slice(0,10)).closed);const signalDay=new Date(ms).toISOString().slice(0,10);assert.equal(mentorSessionAfter(buy,125),end);const input={position:{...position,boughtSession:buy},signal:{...source,day:signalDay},asOfDay:end};const before=plan({...input,asOfMs:Date.parse(end+'T17:59:59Z')}),after=plan({...input,asOfMs:Date.parse(end+'T18:00:00Z')});assert.equal(before.guide.referenceCloseMinute,780);assert.equal(before.guide.stage,'REGISTERED_CLOSE_TODAY');assert.equal(after.guide.stage,'CLOSE_REACHED_EXECUTION_UNVERIFIED');assert.equal(after.guide.executable,false);});
+test('five actual mentorText examples preserve synthetic financial bytes and unresolved context',async()=>{const examples=await mentorReleaseExamples();assert.equal(examples.length,5);for(const x of examples){assert.match(x.text,/NOT PROVEN/);assert.match(x.text,/NOT_ACTIONABLE/);assert.match(x.text,/No executable price\/range is established/);}assert.match(examples.find(x=>x.id==='legacy').text,/ORIGINAL_SIGNAL_IDENTITY_UNKNOWN/);assert.match(examples.find(x=>x.id==='expired').text,/EXPIRED/);assert.match(examples.find(x=>x.id==='missing').text,/NO_VALID_SOURCE_SIGNAL/);assert.match(examples.find(x=>x.id==='contradictory').text,/TARGET_DIFFERS/);});
