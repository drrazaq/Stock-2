+// Actual current-production mentor caller: synthetic loopback, records and key only.
+import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs';import path from 'node:path';import http from 'node:http';import {spawn} from 'node:child_process';import {fileURLToPath} from 'node:url';
+import {loadScan,blocked} from './load-scan.mjs';
+const root=path.dirname(path.dirname(fileURLToPath(import.meta.url)));
+async function fixture(t){let updates=[],sent=[],routes=[],reject=false;const server=http.createServer((req,res)=>{let body='';req.on('data',x=>body+=x);req.on('end',()=>{routes.push(req.url);let out={ok:true,result:[]};if(req.url.includes('/getUpdates')){out.result=updates;updates=[];}else if(req.url.includes('/sendMessage')){sent.push(JSON.parse(body).text);if(reject){res.statusCode=403;out={ok:false};}else out.result={message_id:sent.length};}else assert.fail('unexpected provider/broker route: '+req.url);res.end(JSON.stringify(out));});});await new Promise(r=>server.listen(0,'127.0.0.1',r));t.after(()=>{server.closeAllConnections();server.close();});const base='http://127.0.0.1:'+server.address().port;
+ const s=await loadScan({files:{'data/my-positions.json':{ZZQ:{src:'leader dip',entry:100,target:120,ldHold:126,boughtSession:'2026-10-30',guide:true,t1:999}},'data/leaderdip-ledger.jsonl':[],'data/my-trades.jsonl':[]},env:{PRIVATE_KEY:'SYNTHETIC_MENTOR_ONLY',TG_TOKEN:'synthetic',TG_CHAT:'42',TG_BASE:base}});s.fn('privWrite')({shares:{ZZQ:5},buys:[]});s.write('data/tg-state.json',{offset:0,menuV:s.value('MENU_V')});const protectedNames=['data/my-positions.json','data/private.enc','data/leaderdip-ledger.jsonl','data/my-trades.jsonl','data/settings.json'],before=protectedNames.map(p=>s.read(p));
+ return {s,base,sent,routes,set(text,foreign=false){updates=[{update_id:101,message:{chat:{id:42},text}},...(foreign?[{update_id:102,message:{chat:{id:99},text:'unrelated foreign input'}}]:[])];},reject(){reject=true;},unchanged(){assert.deepEqual(protectedNames.map(p=>s.read(p)),before);assert.equal(blocked.length,0);assert.ok(routes.every(x=>/\/(?:getUpdates|sendMessage)/.test(x)));}};
+}
+for(const text of ['mentor','mentor 123','mentor ZZQ extra','/mentor@fixture ZZQ extra'])test('malformed mentor command refuses without fallback or financial writes: '+text,async t=>{const f=await fixture(t);f.set(text,true);await f.s.fn('tgCommands')(null);f.unchanged();assert.match(f.sent.join('\n'),/MENTOR.*EXPLANATION ONLY/);assert.match(f.sent.join('\n'),/Use mentor SYMBOL/);assert.doesNotMatch(f.sent.join('\n'),/TODAY.S ACTIONS|TOP PICK|OK to buy/);assert.equal(f.s.readJson('data/tg-state.json').offset,103);});
