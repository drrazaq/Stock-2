+const key='synthetic-offline-recovery-key-only',sha='a'.repeat(40);
+function fixture(t){const dir=fs.mkdtempSync(path.join(os.tmpdir(),'repo03-recovery-')),input=path.join(dir,'sealed'),storage=path.join(dir,'storage'),outside=path.join(dir,'outside');for(const p of [input,storage,outside])fs.mkdirSync(p);const body=Buffer.from('SYNTHETIC research bytes only');fs.mkdirSync(path.join(input,'attempt'));fs.writeFileSync(path.join(input,'attempt/case.json.enc'),JSON.stringify(sealResearch(body,key,{sourceSha:sha,path:'attempt/case.json'})));t.after(()=>fs.rmSync(dir,{recursive:true,force:true}));return {dir,input,storage,outside,body,output:path.join(storage,'recovered')};}
+test('authenticated recovery publishes identical bytes with private directory and file permissions',t=>{const f=fixture(t),oldMask=process.umask(0o022);let r;try{r=recoverDirectory(f.input,f.output,key,sha);}finally{process.umask(oldMask);}assert.equal(r.status,'AUTHENTICATED_INCOMPLETE');assert.deepEqual(fs.readFileSync(path.join(f.output,'attempt/case.json')),f.body);for(const p of [f.output,path.join(f.output,'attempt')])assert.equal(fs.statSync(p).mode&0o777,0o700);for(const p of ['attempt/case.json','recovery-report.json'])assert.equal(fs.statSync(path.join(f.output,p)).mode&0o777,0o600);});
+test('output ancestor symlink cannot redirect plaintext publication',t=>{const f=fixture(t),link=path.join(f.dir,'linked');fs.symlinkSync(f.outside,link);assert.throws(()=>recoverDirectory(f.input,path.join(link,'recovered'),key,sha));assert.deepEqual(fs.readdirSync(f.outside),[]);});
+test('existing and dangling output links are preserved without writing their targets',t=>{const f=fixture(t);for(const target of [f.outside,path.join(f.dir,'missing')]){fs.symlinkSync(target,f.output);assert.throws(()=>recoverDirectory(f.input,f.output,key,sha));assert.equal(fs.readlinkSync(f.output),target);fs.unlinkSync(f.output);}assert.deepEqual(fs.readdirSync(f.outside),[]);assert.equal(fs.existsSync(path.join(f.dir,'missing')),false);});
+test('ancestor replacement between directory creation and writes cannot redirect publication',t=>{const f=fixture(t),retained=f.storage+'-retained',mkdir=fs.mkdirSync;let replaced=false;fs.mkdirSync=function(file,...args){const r=mkdir.call(this,file,...args);if(String(file).endsWith('/recovered')&&!replaced){replaced=true;fs.renameSync(f.storage,retained);fs.symlinkSync(f.outside,f.storage);}return r;};let error;try{recoverDirectory(f.input,f.output,key,sha);}catch(e){error=e;}finally{fs.mkdirSync=mkdir;}assert.equal(replaced,true);assert.deepEqual(fs.readdirSync(f.outside),[]);assert.equal(error,undefined);assert.deepEqual(fs.readFileSync(path.join(retained,'recovered/attempt/case.json')),f.body);});
+test('bad authentication creates no output and cannot change sealed bytes',t=>{const f=fixture(t),file=path.join(f.input,'attempt/case.json.enc'),before=fs.readFileSync(file);assert.throws(()=>recoverDirectory(f.input,f.output,'wrong-synthetic-key-only',sha));assert.equal(fs.existsSync(f.output),false);assert.deepEqual(fs.readFileSync(file),before);});
+test('existing output evidence is not replaced or truncated',t=>{const f=fixture(t);fs.mkdirSync(f.output);fs.writeFileSync(path.join(f.output,'retained'),'original fixture bytes');assert.throws(()=>recoverDirectory(f.input,f.output,key,sha),/ALREADY_EXISTS/);assert.equal(fs.readFileSync(path.join(f.output,'retained'),'utf8'),'original fixture bytes');});
+test('publication refusal leaves ciphertext and existing parent contents unchanged',t=>{const f=fixture(t),uid=process.geteuid?.();assert.ok(Number.isInteger(uid)&&uid!==0,'run this permissions regression as a non-root user');fs.writeFileSync(path.join(f.storage,'retained'),'original');fs.chmodSync(f.storage,0o500);try{assert.throws(()=>recoverDirectory(f.input,f.output,key,sha));assert.deepEqual(fs.readdirSync(f.storage),['retained']);assert.equal(fs.existsSync(f.output),false);}finally{fs.chmodSync(f.storage,0o700);}});
