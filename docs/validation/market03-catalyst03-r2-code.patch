+  decisionIngress:new Set(decision.map(p=>p.file+'|'+p.provider)).size,reviewedIngress:new Set(reviewed.map(p=>p.file+'|'+p.provider)).size,fullyCoveredIngress:[...new Set(full.map(p=>p.file+'|'+p.provider))]},pairs};
+}
