diff --git a/docs/validation/production-ignition-noop-workflow.yml b/docs/validation/production-ignition-noop-workflow.yml
new file mode 100644
index 00000000..a4e87a2b
--- /dev/null
+++ b/docs/validation/production-ignition-noop-workflow.yml
@@ -0,0 +1,77 @@
+name: Ignition watcher
+on:
+  schedule:
+    # 8:45 New York in summer. GitHub starts these 35-45 minutes late (first watched minute was 9:38-9:49 every day 16-27 Oct, 11:10 on
+    # 26 Oct), so the old 9:05 start missed the open and the 9:25 pre-market record. If early, the script waits for 9:25 (it accepts
+    # starts from 8:40). The second start covers winter time (from 2 Nov); in summer it queues behind the first (concurrency) and exits.
+    # Trade-off: on a day GitHub starts on time (8:45), the 345-minute run limit ends the watch at about 14:30 instead of 15:00.
+    - cron: '45 12 * * 1-5'
+    - cron: '45 13 * * 1-5'
+  workflow_dispatch:
+permissions:
+  contents: write
+concurrency: ignition
+jobs:
+  watch:
+    runs-on: ubuntu-latest
+    timeout-minutes: 355
+    env:
+      NODE_OPTIONS: --max-old-space-size=8192
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          ref: main
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 20
+      - uses: actions/cache/restore@v4
+        with:
+          path: fm-cache
+          key: fm-cache-none
+          restore-keys: fm-cache-
+      # Checks the whole market every minute for stocks starting to run. Alerts only rules that passed the minute test.
+      - shell: bash
+        run: |
+          set -o pipefail
+          node ignition-watch.mjs 2>&1 | tee run.log
+        env:
+          MASSIVE_KEY: ${{ secrets.MASSIVE_KEY }}
+          ALPACA_KEY: ${{ secrets.ALPACA_KEY }}
+          ALPACA_SECRET: ${{ secrets.ALPACA_SECRET }}
+          FINNHUB_KEY: ${{ secrets.FINNHUB_KEY }}   # (28 Oct) catalyst headlines for early-alert candidates only
+          TG_TOKEN: ${{ secrets.TG_TOKEN }}
+          TG_CHAT: ${{ secrets.TG_CHAT }}
+          SEC_UA: ${{ secrets.SEC_UA || format('{0} {0}@users.noreply.github.com', github.repository_owner) }}
+      # Durable per-stock ledger of today's 15%+ movers (the missed-runner autopsy reads it; no data calls).
+      - if: always()
+        continue-on-error: true
+        run: MR_LEDGER_ONLY=1 node missed-runners.mjs 2>&1 | tee -a run.log
+      - if: always()
+        run: |
+          set -euo pipefail
+          git config user.name "scanner"
+          git config user.email "scanner@users.noreply.github.com"
+          for f in data/ignition-live.json data/ignition-paper.jsonl data/premarket.jsonl data/ignition-days.jsonl data/vol-curve.json data/ignition-missed-history.jsonl data/early-wave-obs.jsonl data/radar-v3-ledger.jsonl data/radar-v3-snap.json data/opp-ledger.jsonl data/opp-days.jsonl; do [ -f "$f" ] && git add "$f"; done; [ -d data/shadow ] && git add data/shadow; [ -d data/ignition-runs ] && git add data/ignition-runs; true
+          git diff --cached --quiet || git commit -m "ignition $(date -u +%F)"
+          ok=0; for i in 1 2 3 4 5; do if git pull --rebase && git push; then ok=1; break; fi; git rebase --abort 2>/dev/null || true; sleep 10; done
+          [ "$ok" = 1 ] || { echo "Error: watcher publication unconfirmed"; exit 1; }
+      - if: failure()
+        env:
+          TG_TOKEN: ${{ secrets.TG_TOKEN }}
+          TG_CHAT: ${{ secrets.TG_CHAT }}
+        run: |
+          WHY=$(grep -iE "error|missing|rejected|refused|cannot|limit|HTTP [45][0-9][0-9]" run.log 2>/dev/null | tail -n 3 | cut -c1-240 || true)
+          curl -s -o /dev/null --data-urlencode "chat_id=$TG_CHAT" --data-urlencode "text=RUN FAILED: ${{ github.workflow }}.${WHY:+ Last error lines: $WHY} Send this message to Claude." "https://api.telegram.org/bot$TG_TOKEN/sendMessage" || true
+
+      - if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: watcher-evidence-${{ github.run_id }}-${{ github.run_attempt }}
+          path: |
+            data/ignition-runs/
+            data/radar-v3-snap.json
+            data/radar-v3-ledger.jsonl
+            data/radar-v3-ledger.jsonl.pending.json
+            runtime/watcher-message-state/
+          retention-days: 7
+          if-no-files-found: warn
