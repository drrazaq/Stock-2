+// Synthetic owner commands only; no real messages, broker/provider calls or financial records.
+import test from 'node:test';import assert from 'node:assert/strict';import http from 'node:http';import fs from 'node:fs';import {loadScan,blocked} from './load-scan.mjs';
+for(const mixed of [false,true])test('mentor-only preserves financial bytes; explicit mixed owner stop keeps existing recording: '+mixed,async t=>{let updates=[],sent=[];const server=http.createServer((req,res)=>{let b='';req.on('data',x=>b+=x);req.on('end',()=>{let out={ok:true,result:[]};if(req.url.includes('/getUpdates')){out.result=updates;updates=[];}else if(req.url.includes('/sendMessage')){sent.push(JSON.parse(b).text);out.result={message_id:1};}res.end(JSON.stringify(out));});});await new Promise(r=>server.listen(0,'127.0.0.1',r));t.after(()=>{server.closeAllConnections();server.close();});const s=await loadScan({files:{'data/my-positions.json':{AMD:{src:'leader dip',entry:100,target:150,stop:90,ldHold:126,boughtSession:'2026-11-02'}},'data/leaderdip-ledger.jsonl':[]},env:{TG_TOKEN:'fixture',TG_CHAT:'42',TG_BASE:'http://127.0.0.1:'+server.address().port,PRIVATE_KEY:'synthetic-only'}});s.fn('privWrite')({shares:{AMD:10},buys:[]});s.write('data/tg-state.json',{offset:0,menuV:s.value('MENU_V')});const files=['data/my-positions.json','data/private.enc','data/leaderdip-ledger.jsonl'],before=files.map(f=>s.read(f));updates=[{update_id:5,message:{chat:{id:42},text:'mentor AMD'}},{update_id:6,message:{chat:{id:99},text:'foreign input'}}];if(mixed)updates.push({update_id:7,message:{chat:{id:42},text:'stop AMD 95'}});await s.fn('tgCommands')(null);assert.match(sent.join('\n'),/MENTOR AMD/);assert.match(sent.join('\n'),/NOT PROVEN/);assert.match(sent.join('\n'),/NOT_ACTIONABLE/);assert.match(sent.join('\n'),/current legacy reminder says next open/);assert.equal(s.read('data/private.enc'),before[1]);assert.equal(s.read('data/leaderdip-ledger.jsonl'),before[2]);if(!mixed)assert.equal(s.read('data/my-positions.json'),before[0]);else assert.equal(s.readJson('data/my-positions.json').AMD.stop,95);assert.ok(s.readJson('data/tg-state.json').offset>=7);assert.equal(fs.existsSync(s.dir+'/data/my-trades.jsonl'),false);assert.equal(blocked.length,0);});
