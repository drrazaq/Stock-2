@@ -76,3 +84,62 @@
         run: |
           WHY=$(grep -iE "error|missing|rejected|refused|cannot|HTTP [45][0-9][0-9]" run.log 2>/dev/null | grep -vE "DeprecationWarning|rate limit pause" | tail -n 3 | cut -c1-240 || true)
           curl -s -o /dev/null --data-urlencode "chat_id=$TG_CHAT" --data-urlencode "text=RUN FAILED: ${{ github.workflow }}.${WHY:+ Last error lines: $WHY} Send this message to Claude." "https://api.telegram.org/bot$TG_TOKEN/sendMessage" || true
+  accounting-preflight:
+    if: ${{ github.event_name == 'workflow_dispatch' && inputs.accounting_preflight }}
+    permissions:
+      contents: read
+    runs-on: ubuntu-latest
+    timeout-minutes: 2
+    outputs:
+      status: ${{ steps.result.outputs.status }}
+    steps:
+      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
+        with:
+          ref: main
+          persist-credentials: false
+      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020
+        with:
+          node-version: 20
+      - name: Verify immutable offline checker
+        shell: bash
+        run: |
+          set -euo pipefail
+          set +x
+          rm -f "$RUNNER_TEMP/accounting-preflight.result"
+          curl --max-time 20 -fsSL https://api.github.com/repos/drrazaq/Stock-2/git/blobs/92fc955497950df6e76823eec6e348f1ebfb78b1 -o "$RUNNER_TEMP/accounting-preflight-source.json" 2>/dev/null
+          node -e 'const fs=require("node:fs"),p=process.env.RUNNER_TEMP,j=JSON.parse(fs.readFileSync(p+"/accounting-preflight-source.json"));if(j.encoding!=="base64")process.exit(1);fs.writeFileSync(p+"/accounting-preflight.mjs",Buffer.from(j.content,"base64"));' >/dev/null 2>&1
+          printf '7d009d803cd565f5edecc43f52dd9f8fc579837c8a76612ff2c7c580e8473b48  %s/accounting-preflight.mjs\n' "$RUNNER_TEMP" | sha256sum -c --status
+          test "$(git hash-object --no-filters "$RUNNER_TEMP/accounting-preflight.mjs")" = 92fc955497950df6e76823eec6e348f1ebfb78b1
+      - name: Protected offline pending-sale check
+        shell: bash
+        env:
+          PRIVATE_KEY: ${{ secrets.PRIVATE_KEY }}
+        run: |
+          set +x
+          ulimit -c 0
+          unset NODE_OPTIONS NODE_PATH
+          rc=0
+          timeout 10s node --max-old-space-size=256 "$RUNNER_TEMP/accounting-preflight.mjs" "$GITHUB_WORKSPACE" > "$RUNNER_TEMP/accounting-preflight.raw" 2>/dev/null || rc=$?
+          value=$(cat "$RUNNER_TEMP/accounting-preflight.raw" 2>/dev/null)
+          case "$rc:$value" in 0:PASS|2:BLOCKED|1:ERROR) ;; *) value=ERROR ;; esac
+          printf '%s\n' "$value" > "$RUNNER_TEMP/accounting-preflight.result"
+          rm -f "$RUNNER_TEMP/accounting-preflight.raw"
+      - name: Emit only protected result after state freshness check
+        id: result
+        if: always()
+        shell: bash
+        env:
+          GIT_TERMINAL_PROMPT: '0'
+        run: |
+          set +x
+          value=$(cat "$RUNNER_TEMP/accounting-preflight.result" 2>/dev/null || true)
+          case "$value" in PASS|BLOCKED|ERROR) ;; *) value=ERROR ;; esac
+          if [ "$value" = PASS ]; then
+            if git fetch --quiet https://github.com/drrazaq/Stock-2.git refs/heads/main >/dev/null 2>&1; then
+              if ! git diff --quiet HEAD FETCH_HEAD -- data/private.enc data/my-positions.json data/my-trades.jsonl data/leaderdip-ledger.jsonl; then value=BLOCKED; fi
+            else value=ERROR; fi
+          fi
+          printf 'status=%s\n' "$value" >> "$GITHUB_OUTPUT"
+          printf '%s\n' "$value"
+          rm -f "$RUNNER_TEMP/accounting-preflight.result" "$RUNNER_TEMP/accounting-preflight.mjs" "$RUNNER_TEMP/accounting-preflight-source.json"
+          case "$value" in PASS) exit 0 ;; BLOCKED) exit 2 ;; *) exit 1 ;; esac
