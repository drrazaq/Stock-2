+  try { await S.fn('intraday')(false); } finally { Date.now = real; }
+  const first = sent.find(x => /FIRST MARKET-HOURS CHECK/.test(x)) || '';
+  return { first, stop: sent.find(x => /^YOUR STOPS/.test(x)) || '', zzs: first.split('\n').find(l => l.startsWith('ZZS:')) || '' };
+}
