+// Synthetic actual daily caller: visibility only; no economic test or historical SNDK diagnosis.
+import test from 'node:test';import assert from 'node:assert/strict';import http from 'node:http';import {loadScan,blocked} from './load-scan.mjs';
+const bars=[];for(let d=new Date('2023-01-01T00:00:00Z');d<=new Date('2026-11-10T00:00:00Z');d.setUTCDate(d.getUTCDate()+1))if(![0,6].includes(d.getUTCDay()))bars.push({datetime:d.toISOString().slice(0,10),open:'10',high:'10.1',low:'9.9',close:'10',volume:'1000000'});
+for(const n of [500,599,600])test('actual nightly preserves '+n+'-bar requested company visibility without a new entry rule',async()=>{const server=http.createServer((req,res)=>{res.setHeader('content-type','application/json');const u=new URL(req.url,'http://local');res.end(JSON.stringify(u.pathname==='/time_series'?{status:'ok',values:bars.slice(u.searchParams.get('symbol')==='SNDK'?-n:-850)}:{}));});await new Promise(r=>server.listen(0,'127.0.0.1',r));try{const s=await loadScan({env:{TD_BASE:'http://127.0.0.1:'+server.address().port,NO_CROWD:'1',RATE:'10000',FORCE:'1',NO_WIDE:'1'},files:{'data/watch-extra.json':['SNDK']}});s.value('LIST').splice(0,s.value('LIST').length,'SPY','SNDK');await s.fn('daily')();const result=s.readJson('data/signals.json'),r=result.stocks.find(x=>x.sym==='SNDK');assert.ok(r);if(n<600){assert.equal(r.availableBars,n);assert.equal(r.requiredBars,600);assert.equal(r.readiness,'INSUFFICIENT_TESTED_HISTORY');assert.equal(r.proven,false);assert.equal(r.trigger,null);assert.equal(r.rule,null);assert.equal(r.state,'No action');assert.equal(r.halal,'unknown');assert.equal(result.diagnosticCount,1);assert.equal(s.fn('universe')(result).some(x=>x.sym==='SNDK'),false);const check=s.fn('checkOne')('SNDK',result);assert.match(check,/existing tested-entry path requires 600/);assert.doesNotMatch(check,/NaN|Rule: null|did not pass/);const live=await s.fn('natural')('what about SNDK',result,{});assert.match(live,/analysed now from/);assert.match(live,new RegExp('This response contains '+n+'/600 completed daily bars'));assert.match(live,/not a strategy rejection or a test of every other lane/);assert.doesNotMatch(live,/NaN|Rule: null|did not pass/);}else assert.notEqual(r.readiness,'INSUFFICIENT_TESTED_HISTORY');assert.equal(blocked.length,0);assert.deepEqual(result.errors,[]);}finally{server.closeAllConnections();server.close();}});
